# Copy to .env (git-ignored) next to compose.yaml. Docker Compose reads it for the ${...} values in the compose file,
# and the worker also receives it as its environment. Every line is optional; the values shown are the defaults.
# Quote values that contain $ or spaces, e.g. INKBUNNY_PASSWORD='p@ss$word'.

# ---- Which site to archive (read by both containers) -----------------------------------------------------------
# An e621ng site. Defaults to e621. STATIC_HOST defaults to static1.<SITE_HOST>; SITE_NAME to the first part of
# SITE_HOST (shown in page titles and texts, and it picks the look: "e621" or "e6ai").
# Never point it at a site you do not want the exports and files of: the downloader refuses redirects off this host.
SITE_HOST=e621.net
STATIC_HOST=
SITE_NAME=

# ---- Getting deleted posts back (worker only) --------------------------------------------------------------------
# Optional Inkbunny account, used for posts deleted on e621 whose source is an Inkbunny submission.
# Blank = the guest login, which only shows general-rated art. For mature art use a dedicated account, turn on the
# mature ratings in its Inkbunny account settings (and API access, if login is refused).
INKBUNNY_USERNAME=
INKBUNNY_PASSWORD=

# ---- Where things live on the host (compose file only) ------------------------------------------------------------
# Folders are created by you (see README) and must be writable by SPANKBANK_UID:SPANKBANK_GID.
# Databases, imports and keys are small and hot: put them on fast storage. Media is big and cold: any disk will do.
SPANKBANK_DB_DIR=./data/db
SPANKBANK_IMPORTS_DIR=./data/imports
SPANKBANK_KEYS_DIR=./data/keys
SPANKBANK_MEDIA_DIR=./data/media
SPANKBANK_UID=1000
SPANKBANK_GID=1000

# ---- Where the site is served (compose file only) ---------------------------------------------------------------
# 127.0.0.1 = this machine only. Use a LAN/VPN address to reach it from other devices. SpankBank has no login.
SPANKBANK_WEB_BIND=127.0.0.1
SPANKBANK_WEB_PORT=8621
