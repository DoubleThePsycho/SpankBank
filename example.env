# Copy to .env (git-ignored) next to compose.yaml. Docker Compose reads it for the ${...} values in the compose file;
# nothing else uses it. Quote values that contain $ or spaces, e.g. INKBUNNY_PASSWORD='p@ss$word'.

# ---- Which site to archive ---------------------------------------------------------------------------------------
# An e621ng site. Required: there is no default. The short name ("e621", "e6ai"; shown in page titles and texts) and
# the look follow from it: e6ai.net gets the black and yellow theme and logo, anything else e621's.
# STATIC_HOST is the host the files come from; leave it empty for static1.<SITE_HOST>.
# Never point it at a site you do not want the exports and files of: the downloader refuses redirects off this host.
SITE_HOST=e621.net
STATIC_HOST=

# ---- Getting deleted posts back (worker only) --------------------------------------------------------------------
# Optional Inkbunny account, used for posts deleted on the site whose source is an Inkbunny submission.
# Blank = the guest login, which only shows general-rated art. For mature art use a dedicated account, turn on the
# mature ratings in its Inkbunny account settings (and API access, if login is refused).
INKBUNNY_USERNAME=
INKBUNNY_PASSWORD=
