# Copy to .env (git-ignored). Read by compose.yaml (the worker).
# Paths are fixed inside the containers; map host folders with `volumes:` in compose.yaml.

# Optional e621 login (leave blank to stay anonymous).
E621_USERNAME=
E621_API_KEY=

# Optional Inkbunny account, used to get back posts deleted on e621 whose source is an Inkbunny submission.
# Blank = the guest login, which only shows general-rated art. For mature art use a dedicated account, turn on the
# mature ratings in its Inkbunny account settings (and API access, if login is refused), and quote the password:
# INKBUNNY_PASSWORD='p@ss$word'
INKBUNNY_USERNAME=
INKBUNNY_PASSWORD=

# Which e621ng site this install archives (read by both containers). Defaults to e621.
# STATIC_HOST defaults to static1.<SITE_HOST>; SITE_NAME to the first part of SITE_HOST (shown in titles and texts).
# Never point it at a site you do not want the exports and files of: the downloader refuses redirects off this host.
SITE_HOST=e621.net
STATIC_HOST=
SITE_NAME=
