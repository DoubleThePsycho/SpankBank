<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SpankBank.Data</RootNamespace>
    <AssemblyName>SpankBank.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Some environments skip a folder named Bin through the SDK's default excludes (and others do not), so add
         it explicitly without duplicating what the default globs already picked up. -->
    <Compile Include="Bin\**\*.cs" Exclude="@(Compile)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\SpankBank.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpankBank.Tests" />
  </ItemGroup>

</Project>
