<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SpankBank.Data</RootNamespace>
    <AssemblyName>SpankBank.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK's default excludes skip any folder named bin/Bin. -->
    <Compile Include="Bin\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\SpankBank.Core.csproj" />
  </ItemGroup>

</Project>
