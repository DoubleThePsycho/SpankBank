{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": ["jquery"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/js/*"], "~/*": ["./*"] }
  },
  "include": ["src"]
}
