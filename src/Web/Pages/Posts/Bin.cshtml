@page "/bin"
@model SpankBank.Web.Pages.Posts.BinModel
@using SpankBank.Data.RubbishBin
@{
    ViewData["Title"] = "Rubbish bin";
    ViewData["BodyClass"] = "c-status";
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"posts"' />
}
<div id="c-bin" class="container"><div id="a-index">
  <h1>Rubbish bin</h1>

  @if (Model.Message is not null) { <div class="notice notice-info">@Model.Message</div> }
  @if (Model.Error is not null) { <div class="notice notice-error">@Model.Error</div> }

  <p>Deleted posts stay here for 30 days, then their files are removed for good. A deleted post is never downloaded again, even after it leaves the bin.</p>

  @if (Model.Posts.Count == 0)
  {
    <p>The bin is empty.</p>
  }
  else
  {
    <form method="post" asp-page-handler="Empty" data-confirm="Remove @Model.Posts.Count post(s) for good? This cannot be undone.">
      <button type="submit" class="st-button" onclick="return confirm('Remove @Model.Posts.Count post(s) for good? This cannot be undone.')">Empty bin (@Model.Posts.Count.ToString("N0"))</button>
    </form>
    <div class="bin-grid" style="display:flex;flex-wrap:wrap;gap:1em;margin-top:1em">
      @foreach (var post in Model.Posts)
      {
        var days = Math.Max(0, (int)Math.Ceiling((post.PurgeAt - DateTimeOffset.UtcNow).TotalDays));
        <figure style="width:160px;margin:0">
          <img src="/bin/preview/@post.PostId" alt="Post @post.PostId" loading="lazy" style="max-width:160px;max-height:160px;display:block">
          <figcaption>
            <div>#@post.PostId</div>
            <div class="hint">@(post.State is BinState.RestoreRequested ? "Restoring..." : post.State is BinState.PurgeRequested ? "Removing..." : $"{days} day(s) left")</div>
            @if (post.State is BinState.Requested or BinState.Binned)
            {
              <form method="post" asp-page-handler="Restore"><input type="hidden" name="id" value="@post.PostId"><button type="submit" class="st-button">Restore</button></form>
            }
          </figcaption>
        </figure>
      }
    </div>
  }
</div></div>
