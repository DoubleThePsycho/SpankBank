@page "/bin"
@model SpankBank.Web.Pages.Posts.BinModel
@using SpankBank.Data.RubbishBin
@{
    ViewData["Title"] = "Rubbish bin";
    ViewData["BodyClass"] = "c-status";
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"posts"' />
}
<div id="c-bin" class="container"><div id="a-index">
  <h1>Rubbish bin</h1>

  @if (Model.Message is not null) { <div class="notice notice-info">@Model.Message</div> }
  @if (Model.Error is not null) { <div class="notice notice-error">@Model.Error</div> }

  <p>Deleted posts stay here for 30 days, then their files are removed for good. A deleted post is never downloaded again, even after it leaves the bin.</p>

  @if (Model.StrayCount > 0)
  {
    <section class="box-section">
      <h2>Stray posts</h2>
      <p>@Model.StrayCount.ToString("N0") downloaded post(s) are not matched by any enabled watch and are not favorites.
        <a href="/posts?tags=stray%3Atrue">Look at them</a> first, favorite the ones you want to keep, then:</p>
      <form method="post" asp-page-handler="BinStrays">
        <button type="submit" class="st-button" onclick="return confirm('Move @Model.StrayCount.ToString("N0") stray post(s) to the bin? They stay there for 30 days.')">Move all strays to the bin (@Model.StrayCount.ToString("N0"))</button>
      </form>
    </section>
  }

  @if (Model.Posts.Count == 0)
  {
    <p>The bin is empty.</p>
  }
  else
  {
    <form method="post" asp-page-handler="Empty" data-confirm="Remove @Model.Posts.Count post(s) for good? This cannot be undone.">
      <button type="submit" class="st-button" onclick="return confirm('Remove @Model.Posts.Count post(s) for good? This cannot be undone.')">Empty bin (@Model.Posts.Count.ToString("N0"))</button>
    </form>
    @* The same thumbnails as the post listing; the stats handle holds the Restore button, and the rating cell stays. *@
    <section class="posts-container bin-posts">
      @foreach (var post in Model.Posts)
      {
        var days = Math.Max(0, (int)Math.Ceiling((post.PurgeAt - DateTimeOffset.UtcNow).TotalDays));
        var letter = (SpankBank.Core.Models.PostRating)post.Rating switch { SpankBank.Core.Models.PostRating.Safe => "s", SpankBank.Core.Models.PostRating.Questionable => "q", _ => "e" };
        var ratingClass = letter switch { "s" => "rating-safe", "q" => "rating-questionable", _ => "rating-explicit" };
        var waiting = post.State is BinState.RestoreRequested or BinState.PurgeRequested;
        <article class="thumbnail @ratingClass" data-id="@post.PostId" data-rating="@letter">
          <a class="thm-link" data-hover-text="ID: @post.PostId&#10;Deleted: @post.DeletedAt.ToString("yyyy-MM-dd HH:mm")&#10;Removed for good in @days day(s)">
            <picture><img src="/bin/preview/@post.PostId" alt="post #@post.PostId" loading="lazy"></picture>
            <span class="thm-duration" title="Removed for good in @days day(s)">@(post.State is BinState.PurgeRequested ? "..." : days + "d")</span>
          </a>
          <form method="post" asp-page-handler="Restore" class="thm-desc thm-rating-@letter">
            <input type="hidden" name="id" value="@post.PostId">
            <button type="submit" class="thm-desc-a thm-restore" disabled="@waiting" title="@(post.State is BinState.RestoreRequested ? "Restoring..." : post.State is BinState.PurgeRequested ? "Being removed..." : $"Put post #{post.PostId} back ({days} day(s) left)")">
              <svg-icon name="undo" width="16" height="16" />
              @(post.State is BinState.RestoreRequested ? "Restoring..." : post.State is BinState.PurgeRequested ? "Removing..." : "Restore")
            </button>
            <span class="thm-desc-b thm-rating">@letter.ToUpperInvariant()</span>
          </form>
        </article>
      }
    </section>
  }
</div></div>
