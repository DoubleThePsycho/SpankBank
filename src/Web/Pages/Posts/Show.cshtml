@page "/posts/{id:long}"
@model SpankBank.Web.Pages.Posts.ShowModel
@inject SpankBank.Data.Repositories.SettingsRepository Settings
@using SpankBank.Core.Models
@using SpankBank.Web.Services
@* Markup follows e621ng app/views/posts/show.html.erb and its sidebar partials (BSD-2, see THIRD-PARTY-NOTICES.md). *@
@{
    var post = Model.Post;
    ViewData["Title"] = $"Post #{post.Id}";
    ViewData["BodyClass"] = "c-posts a-show";
    var ratingLetter = post.Rating switch { PostRating.Safe => "s", PostRating.Questionable => "q", _ => "e" };
    var ratingName = post.Rating switch { PostRating.Safe => "Safe", PostRating.Questionable => "Questionable", _ => "Explicit" };
    var scoreClass = post.Score == 0 ? "neutral" : post.Score > 0 ? "positive" : "negative";
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"posts"' />
}
@section Scripts {
  <script type="module" src="~/dist/posts.js" asp-append-version="true"></script>
  @if (Model.MediaKind == "flash")
  {
    <script type="module" src="~/dist/flash.js" asp-append-version="true"></script>
  }
}

<div id="c-posts"><div id="a-show">
  <div class="post-display" id="post-show-display" data-tab-state="tags">

    <div class="search">
      <section class="post-search">
        <label for="tags" class="post-search-title">Posts</label>
        <span class="post-search-help"></span>
        <form method="get" action="/posts" rel="search" class="post-search-form">
          <textarea name="tags" id="tags" data-autocomplete="tag-query" placeholder="Search posts by tag" rows="1">@Model.Query</textarea>
          <button type="submit" title="Search"><svg-icon name="search" /></button>
        </form>
      </section>

      <partial name="_SearchControls" />
    </div>

    <div class="sidebar">
      <section id="mode-box">
        <label>Tags</label>
      </section>

      <section id="tag-list">
        @if (Model.TagGroups.Count > 0)
        {
          <div class="tag-list-columns" aria-hidden="true"><span></span><span>Local</span><span>Online</span></div>
        }
        @foreach (var (cssName, header, tags) in Model.TagGroups)
        {
          <h5 class="tag-list-header @cssName-tag-list-header" data-category="@cssName">@header</h5>
          <ul class="tag-list @cssName-tag-list">
            @foreach (var tag in tags)
            {
              @await Html.PartialAsync("_TagListRow", new TagListRowModel(cssName, tag, Model.LocalCount(tag.Name), "/posts?tags=" + Uri.EscapeDataString(tag.Name),
                  Model.Query is not null ? Model.SearchUrl(tag.Name) : null, Model.Query is not null ? Model.SearchUrl("-" + tag.Name) : null))
            }
          </ul>
        }
      </section>

      <section id="post-information">
        <h3>Information</h3>
        @if (Model.Extras is { Sources.Count: > 0 } extras)
        {
          <ul class="post-sidebar-info">
            <li class="source-links">Source:
              @foreach (var source in extras.Sources)
              {
                <div class="source-link">
                  @if (source.StartsWith("http://") || source.StartsWith("https://"))
                  {
                    <a href="@source" rel="nofollow noopener">@source</a>
                  }
                  else
                  {
                    @source
                  }
                </div>
              }
            </li>
          </ul>
        }

        <div class="post-sidebar-info post-sidebar-grid">
          <div class="post-sidebar-label">ID</div>
          <div class="post-sidebar-value selectable">@post.Id</div>

          <div class="post-sidebar-label">MD5</div>
          <div class="post-sidebar-value selectable no-overflow">@post.Md5</div>

          <div class="post-sidebar-label">Size</div>
          <div class="post-sidebar-value">
            <span class="selectable">@post.Width x @post.Height</span>
            @if (post.FileSize is { } size) { <text>(<span class="selectable">@ShowModel.HumanSize(size)</span>)</text> }
          </div>

          <div class="post-sidebar-label">Type</div>
          <div class="post-sidebar-value selectable">@post.FileExt.ToUpperInvariant()</div>

          <div class="post-sidebar-label">Status</div>
          <div class="post-sidebar-value">
            <span class="selectable">@(Model.Extras?.IsDeleted == true ? "Deleted" : "Active")</span>
          </div>

          <div class="post-sidebar-break"></div>

          <div class="post-sidebar-label">Rating</div>
          <div class="post-sidebar-value"><span class="selectable rating-@ratingLetter" id="sidebar-rating">@ratingName</span></div>

          <div class="post-sidebar-label">Score</div>
          <div class="post-sidebar-value"><span class="selectable" id="sidebar-score">@post.Score</span></div>

          @if (Model.Extras is { } favs)
          {
            <div class="post-sidebar-label">Faves</div>
            <div class="post-sidebar-value"><span class="selectable" id="sidebar-favcount">@favs.FavCount</span></div>
          }

          <div class="post-sidebar-break"></div>

          <div class="post-sidebar-label">File</div>
          <div class="post-sidebar-value">
            @(post.Status switch
            {
                LocalPostStatus.Recovered => "Recovered (Wayback Machine)",
                LocalPostStatus.SampleOnly => "Sample only",
                _ => "Original",
            })
          </div>
        </div>

        <ul class="post-sidebar-info">
          <li>Posted: <span title="@post.CreatedAt.ToString("u")">@post.CreatedAt.ToString("yyyy-MM-dd")</span></li>
          <li>Saved: <span title="@post.SavedAt.ToString("u")">@post.SavedAt.ToString("yyyy-MM-dd")</span></li>
          <li><a href="@(SiteConfig.Url("posts/" + post.Id))" rel="nofollow noopener">View on @SiteConfig.Name</a></li>
        </ul>
      </section>
    </div>

    <div class="content">
      <div id="image-and-nav">
        @if (Model.PoolNav.Count > 0)
        {
          <div id="nav-links-top" class="ui-corner-all nav-notice"><partial name="_PoolNav" model="Model.PoolNav" /></div>
        }

        @if (post.Status == LocalPostStatus.Recovered)
        {
          <div class="notice notice-info">@SiteConfig.Name has deleted this post. The original was recovered from the Wayback Machine.</div>
        }
        else if (post.Status == LocalPostStatus.SampleOnly || Model.ShowingSample)
        {
          <div class="notice notice-info">@SiteConfig.Name has deleted this post. Only its downsized sample could be recovered.</div>
        }

        <section id="image-container" class="blacklistable" data-post-id="@post.Id" data-is-favorited="@(Model.IsFavorite ? "true" : "false")">
          @switch (Model.MediaKind)
          {
            case "image":
              <picture><img id="image" class="fit-window" src="@Model.MediaUrl" alt="Post #@post.Id" width="@post.Width" height="@post.Height" data-original="@Model.MediaUrl" data-sample="@Model.SampleUrl"></picture>
              break;
            case "video":
              <video id="image" class="fit-window" controls loop preload="metadata" src="@Model.MediaUrl" width="@post.Width" height="@post.Height"></video>
              break;
            case "flash":
              <div id="flash-player" class="flash-player" data-swf="@Model.MediaUrl" data-width="@post.Width" data-height="@post.Height"><p>Loading the Flash player… <a href="@Model.MediaUrl">Download the file</a></p></div>
              break;
            default:
              @if (Model.MediaUrl is not null)
              {
                <p>This file type cannot be shown. <a href="@Model.MediaUrl">Download it</a>.</p>
              }
              else
              {
                <p>The file is not on disk.</p>
              }
              break;
          }
        </section>

        @if (Model.PoolNav.Count > 0)
        {
          <div id="nav-links-bottom" class="ui-corner-all nav-notice"><partial name="_PoolNav" model="Model.PoolNav" /></div>
        }
      </div>

      @* Toolbar ported from e621ng app/views/posts/partials/show/content/_toolbar.html.erb (BSD-2, see THIRD-PARTY-NOTICES.md); no votes, edit or notes here. *@
      <section id="ptbr-wrapper">
        <div class="ptbr-row">
          <div class="ptbr-favorite">
            <button type="button" class="st-button kinetic ptbr-favorite-button anim" favorited="@(Model.IsFavorite ? "true" : "false")" processing="false" title="Favorite" data-hotkey="favorite">
              <svg-icon name="star" />
            </button>
          </div>

          @if (Model.MediaKind is "image" or "video")
          {
            <div class="ptbr-resize">
              <select id="image-resize-selector" class="st-button" aria-label="Select image size">
                <option value="original">Original</option>
                <option value="fit" selected>Fit (Horizontal)</option>
                <option value="fitv">Fit (Vertical)</option>
                @if (Model.SampleUrl is not null) { <option value="large">Sample</option> }
              </select>
            </div>
          }
        </div>

        <div class="ptbr-row">
          @if (Settings.Get(SpankBank.Data.WorkerSettingsKeys.DeleteModeEnabled) == "true")
          {
            <div class="ptbr-delete">
              <button type="button" class="st-button kinetic ptbr-delete-button" title="Move this post to the rubbish bin">Delete</button>
            </div>
          }
          @if (Model.MediaUrl is not null)
          {
            <div class="ptbr-fullscreen">
              <a href="@Model.MediaUrl" class="st-button kinetic ptbr-fullscreen-button" data-hotkey="fullscreen" title="View Full Size">Fullscreen</a>
            </div>
          }
        </div>
      </section>

      <div class="bottom-notices">
        <div class="parent-children">
          @if (post.ParentId is { } parentId)
          {
            <div class="notice notice-child">
              Parent: <a href="@(Model.ParentIsLocal ? $"/posts/{parentId}" : SiteConfig.Url($"posts/{parentId}"))">post #@parentId</a>
              (<a href="@(SiteConfig.Url($"wiki_pages/{SiteConfig.Name}:post_relationships"))" rel="nofollow noopener">learn more</a>)
              @if (Model.ParentPreview.Count > 0) { <a href="#" id="has-parent-relationship-preview-link" data-hotkey="postrel">show »</a> }
              <div id="has-parent-relationship-preview" style="display: none;">
                @foreach (var related in Model.ParentPreview) { <partial name="_PostThumbnail" model="related" /> }
              </div>
            </div>
          }
          @if (Model.ChildIds.Count > 0)
          {
            <div class="notice notice-parent">
              Children: <a href="/posts?tags=parent:@post.Id">@(Model.ChildIds.Count == 1 ? "1 child" : $"{Model.ChildIds.Count} children")</a>
              (<a href="@(SiteConfig.Url($"wiki_pages/{SiteConfig.Name}:post_relationships"))" rel="nofollow noopener">learn more</a>)
              <a href="#" id="has-children-relationship-preview-link" data-hotkey="postrel">show »</a>
              <div id="has-children-relationship-preview" style="display: none;">
                @foreach (var related in Model.ChildPreview) { <partial name="_PostThumbnail" model="related" /> }
              </div>
            </div>
          }
        </div>
      </div>

      @if (!string.IsNullOrWhiteSpace(post.Description))
      {
        <div id="post-description-container" class="styled-dtext">
          <details id="description" open>
            <summary>Description</summary>
            <div style="white-space: pre-wrap;">@post.Description</div>
          </details>
        </div>
      }
    </div>
  </div>
</div></div>
