@page "/posts"
@model SpankBank.Web.Pages.Posts.IndexModel
@* Markup ported from e621ng app/views/posts/index.html.erb and its partials (BSD-2, see THIRD-PARTY-NOTICES.md). *@
@{
    ViewData["Title"] = Model.IsFavorites ? "Favorites" : "Posts";
    ViewData["BodyClass"] = "c-posts a-index"; // the upstream styles key the page layout off these body classes
    var current = Model.PageNumber;
    var last = Model.LastPage;
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"posts"' />
}
@section Scripts {
  <script type="module" src="~/dist/posts.js" asp-append-version="true"></script>
}

<div id="c-posts"><div id="a-index"><div class="post-index">

  <div class="search">
    <section class="post-search">
      <label for="tags" class="post-search-title">@(Model.IsFavorites ? "Favorites" : "Posts")</label>
      <span class="post-search-help"></span>

      <form method="get" action="@Model.BasePath" rel="search" class="post-search-form">
        <textarea name="tags" id="tags" data-autocomplete="tag-query" placeholder="Search posts by tag" rows="1">@Model.Tags</textarea>
        <button type="submit" title="Search"><svg-icon name="search" /></button>
      </form>
    </section>

    <partial name="_SearchControls" />
  </div>

  <div class="sidebar">
    <section id="mode-box">
      <label>Tags</label>
    </section>

    <section id="tag-box">
      @foreach (var (cssName, header, tags) in Model.SidebarGroups)
      {
        <h5 class="tag-list-header @cssName-tag-list-header" data-category="@cssName">@header</h5>
        <ul class="tag-list @cssName-tag-list">
          @foreach (var tag in tags)
          {
            <li class="tag-list-item tag-@cssName" data-name="@tag.Name" data-category="@cssName" data-count="@tag.PostCount">
              <a class="tag-list-wiki" rel="nofollow" href="https://e621.net/wiki_pages/show_or_new?title=@Uri.EscapeDataString(tag.Name)">?</a>
              @if (!string.IsNullOrWhiteSpace(Model.Tags))
              {
                <a rel="nofollow" href="@Model.TagUrl(tag.Name)" class="tag-list-inc">+</a>
                <a rel="nofollow" href="@Model.TagUrl("-" + tag.Name)" class="tag-list-exl">–</a>
              }
              <a rel="nofollow tag" class="tag-list-search" href="@Model.BasePath?tags=@Uri.EscapeDataString(tag.Name)">
                <span class="tag-list-name">@tag.Name.Replace('_', ' ')</span>
                <span data-count="@tag.PostCount" class="tag-list-count">@ShowModel.CountLabel(tag.PostCount)</span>
              </a>
            </li>
          }
        </ul>
      }
    </section>
  </div>

  <div class="content">
    <div class="posts-info-bar">
      @if (Model.SearchError is not null)
      {
        <span class="posts-info-empty">@Model.SearchError</span>
      }
      else if (Model.Items.Count == 0 && Model.ChildFolders.Count == 0 && Model.CurrentFolder is null)
      {
        <span class="posts-info-empty">@(string.IsNullOrWhiteSpace(Model.Tags) ? (Model.IsFavorites ? "No favorites yet. Use the star under a post." : "Nothing downloaded yet.") : "Nobody here but us chickens!")</span>
      }
      <span class="posts-info-count">@Model.Total.ToString("N0") @(Model.IsFavorites ? "favorites" : "local posts")</span>
    </div>

    <div id="posts" class="post-index-gallery">
      @if (Model.Artist is { } artist)
      {
        @* Like e621's wiki excerpt above the posts, with what the catalog knows about the artist. *@
        <section class="wiki-excerpt loading hidden">
          <h3 role="button" class="wiki-excerpt-toggle">
            <svg-icon name="chevron_right" />
            <span class="category-1">Artist: @artist.Name.Replace('_', ' ')</span>
            <button type="button" class="st-button icon wiki-excerpt-dismiss"><svg-icon name="times" /></button>
          </h3>
          <div class="styled-dtext">
            @if (artist.OtherNames.Count > 0) { <p>Other names: @string.Join(", ", artist.OtherNames.Select(n => n.Replace('_', ' ')))</p> }
            <p>@artist.PostCount.ToString("N0") posts online, @Model.Total.ToString("N0") @(Model.IsFavorites ? "favorited" : "local").</p>
          </div>
          <a href="/artist/@Uri.EscapeDataString(artist.Name)" class="wiki-excerpt-readmore"><span>Artist page</span></a>
        </section>
      }
      <section class="posts-container@(Model.FolderView ? " favorites-view" : "")">
        @if (Model.FolderView)
        {
          @if (Model.CurrentFolder is { } here)
          {
            <article class="thumbnail favorite-go-up-card" data-drop-target="go-up" data-destination-folder-id="@here.ParentId">
              <a href="@(here.ParentId is { } up ? $"/favorites?folder_id={up}" : "/favorites")" class="thm-link favorite-go-up-card-link" aria-label="Go up one folder level"><svg-icon name="corner_up_left" /></a>
              <div class="thm-desc favorite-go-up-card-desc"><span class="thm-desc-a favorite-go-up-card-name"><span class="favorite-go-up-card-name-text">Go Up</span></span></div>
            </article>
          }
          <article class="thumbnail favorite-new-folder-card">
            <button type="button" id="favorite-folder-new-trigger" class="favorite-new-folder-card-link" data-parent-id="@Model.CurrentFolder?.Id" aria-label="Create a new folder"><svg-icon name="folder_plus" /></button>
            <div class="thm-desc favorite-new-folder-card-desc"><span class="thm-desc-a favorite-new-folder-card-name"><span class="favorite-new-folder-card-name-text">New Folder</span></span></div>
          </article>
          @foreach (var folder in Model.ChildFolders)
          {
            <article class="thumbnail favorite-folder-card" data-drop-target="folder" data-folder-drag-source="true" data-folder-id="@folder.Id" data-folder-name="@folder.Name">
              <a href="/favorites?folder_id=@folder.Id" class="thm-link favorite-folder-card-link" aria-label="Open folder @folder.Name">
                <svg-icon name="folder" class="folder-icon-closed" /><svg-icon name="folder_open" class="folder-icon-open" />
              </a>
              <div class="thm-desc favorite-folder-card-desc">
                <button type="button" class="thm-desc-b favorite-folder-action-cell favorite-folder-action-btn favorite-folder-rename-trigger" data-folder-id="@folder.Id" data-folder-name="@folder.Name" title="Rename folder" aria-label="Rename folder @folder.Name"><svg-icon name="pencil" width="16" height="16" /></button>
                <span class="thm-desc-a favorite-folder-card-name"><span class="favorite-folder-card-name-text">@folder.Name</span></span>
                <button type="button" class="thm-desc-b favorite-folder-action-cell favorite-folder-action-btn favorite-folder-delete-trigger" data-folder-id="@folder.Id" data-folder-name="@folder.Name" title="Delete folder" aria-label="Delete folder @folder.Name"><svg-icon name="trash" width="16" height="16" /></button>
              </div>
            </article>
          }
        }
        @foreach (var post in Model.Items)
        {
          <partial name="_PostThumbnail" model="post" view-data='new ViewDataDictionary(ViewData) { { "Query", Model.PostQuery } }' />
        }
      </section>

      <partial name="_Paginator" model="new SpankBank.Web.Services.PagerModel(current, last, Model.PageUrl)" />
    </div>
  </div>

</div></div></div>
