@page "/posts"
@model SpankBank.Web.Pages.Posts.IndexModel
@* Markup ported from e621ng app/views/posts/index.html.erb and its partials (BSD-2, see THIRD-PARTY-NOTICES.md). *@
@{
    ViewData["Title"] = Model.IsFavorites ? "Favorites" : "Posts";
    ViewData["BodyClass"] = "c-posts a-index"; // the upstream styles key the page layout off these body classes
    var current = Model.PageNumber;
    var last = Model.LastPage;
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"posts"' />
}
@section Scripts {
  <script type="module" src="~/dist/posts.js" asp-append-version="true"></script>
}

<div id="c-posts"><div id="a-index"><div class="post-index">

  <div class="search">
    <section class="post-search">
      <label for="tags" class="post-search-title">@(Model.IsFavorites ? "Favorites" : "Posts")</label>
      <span class="post-search-help"></span>

      <form method="get" action="@Model.BasePath" rel="search" class="post-search-form">
        <textarea name="tags" id="tags" data-autocomplete="tag-query" placeholder="Search posts by tag" rows="1">@Model.Tags</textarea>
        <button type="submit" title="Search"><svg-icon name="search" /></button>
      </form>
    </section>

    <partial name="_SearchControls" />
  </div>

  <div class="sidebar">
    <section id="mode-box">
      <label>Tags</label>
    </section>

    <section id="tag-box">
      @foreach (var (cssName, header, tags) in Model.SidebarGroups)
      {
        <h5 class="tag-list-header @cssName-tag-list-header" data-category="@cssName">@header</h5>
        <ul class="tag-list @cssName-tag-list">
          @foreach (var tag in tags)
          {
            <li class="tag-list-item tag-@cssName" data-name="@tag.Name" data-category="@cssName" data-count="@tag.PostCount">
              <a class="tag-list-wiki" rel="nofollow" href="https://e621.net/wiki_pages/show_or_new?title=@Uri.EscapeDataString(tag.Name)">?</a>
              @if (!string.IsNullOrWhiteSpace(Model.Tags))
              {
                <a rel="nofollow" href="@Model.TagUrl(tag.Name)" class="tag-list-inc">+</a>
                <a rel="nofollow" href="@Model.TagUrl("-" + tag.Name)" class="tag-list-exl">–</a>
              }
              <a rel="nofollow tag" class="tag-list-search" href="@Model.BasePath?tags=@Uri.EscapeDataString(tag.Name)">
                <span class="tag-list-name">@tag.Name.Replace('_', ' ')</span>
                <span data-count="@tag.PostCount" class="tag-list-count">@ShowModel.CountLabel(tag.PostCount)</span>
              </a>
            </li>
          }
        </ul>
      }
    </section>
  </div>

  <div class="content">
    <div class="posts-info-bar">
      @if (Model.SearchError is not null)
      {
        <span class="posts-info-empty">@Model.SearchError</span>
      }
      else if (Model.Items.Count == 0)
      {
        <span class="posts-info-empty">@(string.IsNullOrWhiteSpace(Model.Tags) ? (Model.IsFavorites ? "No favorites yet. Use the star under a post." : "Nothing downloaded yet.") : "Nobody here but us chickens!")</span>
      }
      <span class="posts-info-count">@Model.Total.ToString("N0") @(Model.IsFavorites ? "favorites" : "local posts")</span>
    </div>

    <div id="posts" class="post-index-gallery">
      <section class="posts-container">
        @foreach (var post in Model.Items)
        {
          <partial name="_PostThumbnail" model="post" />
        }
      </section>

      <partial name="_Paginator" model="new SpankBank.Web.Services.PagerModel(current, last, Model.PageUrl)" />
    </div>
  </div>

</div></div></div>
