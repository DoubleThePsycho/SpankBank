@page "/pools/local"
@model SpankBank.Web.Pages.Pools.LocalModel
@{
    ViewData["Title"] = "Local pools";
    var view = Model.View;
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"pools"' />
}
@section Scripts {
  <script type="module" src="~/dist/watches.js" asp-append-version="true"></script>
}
<div id="c-pools" class="container-fluid">
  <div id="a-index">
    <partial name="_ListHeader" model='new SpankBank.Web.Services.ListHeaderModel("Local pools", Model.SearchActive, "Add pool")' />

    <div class="search-dropdown" id="searchform" hidden="@(!Model.SearchActive)">
      <form method="get" action="/pools/local" class="simple_form inline-form">
        <div class="input string"><label for="name">Name</label><input type="text" id="name" name="name" value="@Model.Name" autocomplete="off"><p class="hint">Use * for wildcard; a pool id works too</p></div>
        <div class="input string"><label for="artist">Artist</label><input type="text" id="artist" name="artist" value="@Model.Artist" autocomplete="off"><p class="hint">The artist a pool was added for</p></div>
        @if (Model.ShowDisabled) { <input type="hidden" name="show" value="disabled"> }
        <input type="hidden" name="sort" value="@view.Sort"><input type="hidden" name="dir" value="@(view.Descending ? "desc" : "asc")">
        <input type="submit" value="Search" class="st-button">
      </form>
    </div>

    @if (Model.Message is not null) { <div class="notice notice-info">@Model.Message</div> }
    @if (Model.Error is not null) { <div class="notice notice-error">@Model.Error</div> }

    @if (Model.Pools.Total == 0)
    {
      <p>@(Model.SearchActive ? "No watched pools match." : "Nothing watched.")</p>
    }
    else
    {
      <partial name="_PoolsTable" model='new SpankBank.Web.Services.PoolsTableModel(Model.Pools.Items, "/pools/local?handler=Toggle", view, ShowArtist: true, Editable: true)' />

      @if (Model.Pools.LastPage > 1)
      {
        <div class="list-footer">
          <partial name="_Paginator" model="new SpankBank.Web.Services.PagerModel(view.Page, Model.Pools.LastPage, view.PageUrl)" />
        </div>
      }
    }
    <p class="hint">
      @if (Model.ShowDisabled) { <a href="/pools/local">Hide disabled pools</a> }
      else if (Model.DisabledCount > 0) { <a href="/pools/local?show=disabled">Show @Model.DisabledCount.ToString("N0") disabled pool@(Model.DisabledCount == 1 ? "" : "s")</a> }
    </p>

    <div class="st-overlay hidden" id="modal-add" role="dialog" aria-modal="true" aria-labelledby="modal-add-title" tabindex="-1">
      <div class="st-overlay-wrapper">
        <button type="button" class="st-button close-button" aria-label="Close">&times;</button>
        <form method="post" asp-page-handler="Add" class="simple_form">
          <h1 id="modal-add-title">Add pool</h1>
          <div class="input">
            <label for="add-pool">Pool ID or URL</label>
            <input type="text" name="pool" id="add-pool" autocomplete="off" required>
          </div>
          <button type="submit" class="st-button submit">Add</button>
        </form>
      </div>
    </div>

    @foreach (var pool in Model.Pools.Items.Select(i => i.Entry))
    {
      <partial name="_PoolModal" model="pool" />
    }
  </div>
</div>
