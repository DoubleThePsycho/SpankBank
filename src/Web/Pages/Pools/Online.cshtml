@page "/pools/online"
@model SpankBank.Web.Pages.Pools.OnlineModel
@* Markup follows e621ng app/views/pools/index.html.erb and _search.html.erb (BSD-2, see THIRD-PARTY-NOTICES.md). *@
@{
    ViewData["Title"] = "Online pools";
}
@section Scripts {
  <script type="module" src="~/dist/watches.js" asp-append-version="true"></script>
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"pools"' />
}
<div id="c-pools" class="container-fluid">
  <div id="a-index">
    @* The search form is folded away until the Search button is pressed; it is open while a search is active. *@
    <partial name="_ListHeader" model='new SpankBank.Web.Services.ListHeaderModel("Online pools", Model.SearchActive)' />

    <div class="search-dropdown" id="searchform" hidden="@(!Model.SearchActive)">
      <form method="get" action="/pools/online" class="simple_form inline-form">
        <div class="input string"><label for="name">Name</label><input type="text" id="name" name="name" value="@Model.Name"></div>
        <div class="input string"><label for="description">Description</label><input type="text" id="description" name="description" value="@Model.Description"></div>
        <div class="input select">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="">Any</option>
            <option value="active" selected="@(Model.Status == "active")">Active</option>
            <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
          </select>
        </div>
        <div class="input select">
          <label for="category">Category</label>
          <select id="category" name="category">
            <option value="">Any</option>
            <option value="series" selected="@(Model.Category == "series")">Series</option>
            <option value="collection" selected="@(Model.Category == "collection")">Collection</option>
          </select>
        </div>
        <div class="input select">
          <label for="order">Order</label>
          <select id="order" name="order">
            <option value="updated" selected="@(Model.Order == "updated")">Last updated</option>
            <option value="name" selected="@(Model.Order == "name")">Name</option>
            <option value="created" selected="@(Model.Order == "created")">Recently created</option>
            <option value="count" selected="@(Model.Order == "count")">Post count</option>
          </select>
        </div>
        <input type="submit" value="Search" class="st-button">
      </form>
    </div>

    <table class="striped">
      <thead><tr><th width="60%">Name</th><th width="10%">Count</th><th width="15%">Type</th><th width="15%"></th></tr></thead>
      <tbody>
        @foreach (var pool in Model.Result.Rows)
        {
          <tr id="pool-@pool.Id" class="pool-category-@pool.Category">
            <td><a href="/pool/@pool.Id">@pool.Name.Replace('_', ' ')</a></td>
            <td>@pool.PostCount.ToString("N0")</td>
            <td>@pool.Category</td>
            <td>@(Model.Watched.Contains(pool.Id.ToString()) ? "local" : "")</td>
          </tr>
        }
        @if (Model.Result.Rows.Count == 0)
        {
          <tr><td colspan="4">No pools match.</td></tr>
        }
      </tbody>
    </table>

    <partial name="_Paginator" model="new SpankBank.Web.Services.PagerModel(Model.PageNumber, Model.LastPage, Model.PageUrl)" />
  </div>
</div>
