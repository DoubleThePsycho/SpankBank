@model IReadOnlyList<SpankBank.Data.Repositories.WatchEntry>
@if (Model.Count == 0)
{
  <p>Nothing watched.</p>
}
else
{
  <table class="striped">
    <thead><tr><th>Entry</th><th>Status</th><th></th></tr></thead>
    <tbody>
      @foreach (var entry in Model)
      {
        <tr>
          <td>@entry.DisplayName</td>
          <td>@(entry.Enabled ? "enabled" : "disabled")</td>
          <td>
            <form method="post" asp-page="/Watches/Index" asp-page-handler="Toggle" style="display:inline">
              <input type="hidden" name="id" value="@entry.Id"><input type="hidden" name="enabled" value="@((!entry.Enabled).ToString().ToLowerInvariant())">
              <button type="submit" class="st-button">@(entry.Enabled ? "Disable" : "Enable")</button>
            </form>
            <form method="post" asp-page="/Watches/Index" asp-page-handler="Delete" style="display:inline">
              <input type="hidden" name="id" value="@entry.Id">
              <button type="submit" class="st-button">Remove</button>
            </form>
          </td>
        </tr>
      }
    </tbody>
  </table>
}
