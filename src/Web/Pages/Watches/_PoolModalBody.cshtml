@model SpankBank.Data.Repositories.WatchEntry
<div data-summary data-name="@Model.DisplayName" data-type="@(Model.Pool?.Category ?? "-")" data-pages="@(Model.Pool?.PostCount.ToString("N0") ?? "-")" data-status="@(Model.Enabled ? "enabled" : "disabled")">
  <form method="post" asp-page-handler="Rename" data-ajax class="watch-rename">
    <input type="hidden" name="id" value="@Model.Id">
    <label for="name-@Model.Id">Name</label>
    <div class="watch-rename-row">
      <input type="text" name="name" id="name-@Model.Id" value="@Model.DisplayName" data-original="@Model.DisplayName" maxlength="200" autocomplete="off">
      <button type="submit" class="st-button" disabled>Save</button>
    </div>
    <p class="hint">Renames are local only</p>
  </form>

  <table class="striped">
    <tbody>
      <tr><th>Type</th><td>@(Model.Pool?.Category ?? "not in the export yet")</td></tr>
      <tr><th>Pages</th><td>@(Model.Pool?.PostCount.ToString("N0") ?? "-")</td></tr>
      <tr><th>Status</th><td>@(Model.Enabled ? "enabled" : "disabled")</td></tr>
    </tbody>
  </table>

  <div class="watch-actions">
    <form method="post" asp-page-handler="Toggle" data-ajax>
      <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="enabled" value="@((!Model.Enabled).ToString().ToLowerInvariant())">
      <button type="submit" class="st-button">@(Model.Enabled ? "Disable" : "Enable")</button>
    </form>
    <form method="post" asp-page-handler="Delete" data-ajax data-confirm="Remove this pool?">
      <input type="hidden" name="id" value="@Model.Id">
      <button type="submit" class="st-button">Remove</button>
    </form>
  </div>
</div>
