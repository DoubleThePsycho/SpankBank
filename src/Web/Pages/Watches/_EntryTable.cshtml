@model IReadOnlyList<SpankBank.Data.Repositories.WatchEntry>
@if (Model.Count == 0)
{
  <p>Nothing watched.</p>
}
else
{
  <table class="striped watches-table">
    <thead><tr><th>Entry</th><th>Status</th></tr></thead>
    <tbody>
      @foreach (var entry in Model)
      {
        <tr data-open-modal="modal-@entry.Id" tabindex="0">
          <td data-field="name">@entry.DisplayName</td>
          <td data-field="status">@(entry.Enabled ? "enabled" : "disabled")</td>
        </tr>
      }
    </tbody>
  </table>
}
