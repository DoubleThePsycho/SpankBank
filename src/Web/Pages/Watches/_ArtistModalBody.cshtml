@model SpankBank.Data.Repositories.WatchEntry
@using SpankBank.Core.Models
@{
    var aliases = Model.ArtistTags.Where(t => t.Kind == ArtistTagKind.Alias).Select(t => t.Tag).ToList();
    var characters = Model.ArtistTags.Where(t => t.Kind == ArtistTagKind.Character).ToList();
}
<div data-summary data-status="@(Model.Enabled ? "enabled" : "disabled")" data-aliases="@aliases.Count" data-characters="@characters.Count(c => c.Enabled) / @characters.Count" data-matches="@Model.MatchText">
  <p class="watch-aliases">Matches @Model.MatchText posts in the catalog.@if (Model.SuggestedPools > 0) { <text> <a href="/pools/local#suggested">@Model.SuggestedPools suggested pool@(Model.SuggestedPools == 1 ? "" : "s") →</a></text> }</p>
  @if (aliases.Count > 0)
  {
    <p class="watch-aliases">Also known as: @string.Join(", ", aliases)</p>
  }

  <table class="striped watch-tags">
    <thead><tr><th>Character</th><th></th><th></th></tr></thead>
    <tbody>
      @foreach (var tag in characters)
      {
        <tr class="@(tag.Enabled ? null : "disabled")">
          <td><a href="#" class="tag-type-4">@tag.Tag</a></td>
          <td class="watch-manual">@(tag.IsManual ? "(manual)" : "")</td>
          <td class="watch-row-actions">
            <form method="post" asp-page-handler="ToggleTag" data-ajax>
              <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="tagId" value="@tag.Id"><input type="hidden" name="enabled" value="@((!tag.Enabled).ToString().ToLowerInvariant())">
              <a href="#" data-submit>@(tag.Enabled ? "Disable" : "Enable")</a>
            </form>
            @if (tag.IsManual)
            {
              <form method="post" asp-page-handler="RemoveTag" data-ajax>
                <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="tagId" value="@tag.Id">
                <a href="#" data-submit>Remove</a>
              </form>
            }
          </td>
        </tr>
      }
    </tbody>
  </table>

  <div class="watch-actions">
    <form method="post" asp-page-handler="Toggle" data-ajax>
      <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="enabled" value="@((!Model.Enabled).ToString().ToLowerInvariant())">
      <button type="submit" class="st-button">@(Model.Enabled ? "Disable artist" : "Enable artist")</button>
    </form>
    <form method="post" asp-page-handler="Rescan" data-ajax>
      <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="artist" value="@Model.SourceValue">
      <button type="submit" class="st-button">Rescan</button>
    </form>
    <form method="post" asp-page-handler="IgnoreBlacklist" data-ajax title="Download this watch's posts even when the blacklist matches them">
      <input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="ignore" value="@((!Model.IgnoreBlacklist).ToString().ToLowerInvariant())">
      <button type="submit" class="st-button">@(Model.IgnoreBlacklist ? "Use blacklist" : "Ignore blacklist")</button>
    </form>
    <form method="post" asp-page-handler="Delete" data-ajax data-confirm="Remove @Model.SourceValue?">
      <input type="hidden" name="id" value="@Model.Id">
      <button type="submit" class="st-button">Remove artist</button>
    </form>
  </div>
</div>
