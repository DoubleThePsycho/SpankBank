@* Structure ported from e621ng app/views/layouts/default.html.erb and layouts/navigation (BSD-2, see THIRD-PARTY-NOTICES.md). *@
@{
    var path = Context.Request.Path.Value ?? "/";
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>@(ViewData["Title"] is string pageTitle ? $"{pageTitle} - {SiteConfig.Name}" : $"SpankBank ({SiteConfig.Name} archive)")</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#00549e">
  <meta name="blacklisted-tags" content="[]">
  <meta name="blacklist-users" content="false">
  @* Read by the autocomplete (js/components/autocomplete/Constants.ts). Subset of e621ng's TagQuery lists. *@
  <meta name="tag-categories" content='["general","artist","copyright","character","species","invalid","meta","lore"]'>
  <meta name="metatags" content='["md5","order","limit","child","id","filetype","type","rating","description","parent","user","approver","source","status","pool","set","fav","favoritedby","note","locked","width","height","mpixels","ratio","filesize","duration","score","favcount","date","age","change","tagcount","comment_count","hassource","hasdescription","isparent","ischild","inpool"]'>
  <meta name="order-metatags" content='["id","id_desc","score","score_asc","favcount","favcount_asc","tagcount","tagcount_asc","mpixels","mpixels_asc","filesize","filesize_asc","landscape","portrait","duration","duration_asc","random","hot","change","change_asc"]'>
  <link rel="stylesheet" href="~/dist/application.css" asp-append-version="true">
  <script type="module" src="~/dist/application.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Head", required: false)
</head>
<body lang="en" class="resp @(ViewData["BodyClass"])" data-user-id="" data-user-name="Anonymous" data-user-level="0" data-user-level-string="Member" data-user-is-anonymous="false">
  <script>
    (function () {
      try {
        const values = {
          "th-main": localStorage.getItem("theme") || "hexagon",
          "th-extra": localStorage.getItem("theme-extra") || "hexagon",
          "th-stickyheader": localStorage.getItem("theme-sheader") || false,
          "th-palette": localStorage.getItem("theme-palette") || "default",
          "th-font": localStorage.getItem("theme-font") || "Verdana",
          "th-nav": localStorage.getItem("theme-nav") || "top",
          "th-logo": localStorage.getItem("theme-logo") || "default",
          "st-fullscreen": localStorage.getItem("e6.posts.fusk") || false,
          "st-cornerribbons": localStorage.getItem("e6.posts.cribbons") || true,
          "st-stickysearch": localStorage.getItem("e6.posts.ssearch") || false,
          "st-contain": localStorage.getItem("e6.posts.contain") || false,
          "st-size": localStorage.getItem("e6.posts.size") || "m",
        };
        for (const [name, value] of Object.entries(values))
          document.body.setAttribute("data-" + name, value);
      } catch (e) {}
    })();
  </script>

  <nav class="navigation" role="navigation">
    <menu class="nav-logo">
      <a href="/" class="nav-logo-link" aria-label="Home Page"></a>
    </menu>

    <menu class="nav-primary desktop">
      @foreach (var (text, icon, url, alsoUnder) in new[]
      {
          ("Artists", "brush", "/artists", "/artist/"), ("Posts", "images", "/posts", ""), ("Pools", "library", "/pools", "/pool/"),
          ("Searches", "search", "/searches", ""), ("Tags", "tags", "/tags", ""), ("Status", "settings", "/status", ""),
      })
      {
        var id = "nav-" + text.ToLowerInvariant();
        var current = path.StartsWith(url, StringComparison.OrdinalIgnoreCase) || (alsoUnder.Length > 0 && path.StartsWith(alsoUnder, StringComparison.OrdinalIgnoreCase));
        <li id="@id" class="@(current ? "current" : null)">
          <a href="@url" id="@id-link"><svg-icon name="@icon" /> <span>@text</span></a>
        </li>
      }
    </menu>

    <menu class="nav-secondary desktop @(IsSectionDefined("SecondaryNav") ? null : "empty")">
      @await RenderSectionAsync("SecondaryNav", required: false)
    </menu>
    <menu class="nav-controls desktop">
      <a role="button" id="nav-toggle" class="nav-controls-toggle" aria-label="Toggle Navigation">
        <span>
          <svg-icon name="hamburger" class="off" />
          <svg-icon name="times" class="on" />
        </span>
      </a>
    </menu>
    <menu class="nav-tools desktop">
      <li id="nav-settings" class="nav-tools-settings" title="Settings"><a id="nav-settings-link" aria-label="Settings" href="/settings"><svg-icon name="settings" /> <span>Settings</span></a></li>
    </menu>
    <menu class="nav-help desktop"></menu>
  </nav>

  <div id="page" role="main">
    @RenderBody()
  </div>

  <footer class="footer-wrapper">
    <div class="footer-grid">
      <span class="footer-left"></span>
      <span class="footer-right">
        <span class="footer-running">SpankBank (@SiteConfig.Name archive)</span>
      </span>
    </div>
  </footer>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
