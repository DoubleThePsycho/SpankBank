@model string
@inject SpankBank.Data.Repositories.WatchesRepository Watches
@* The second navigation row of an area. "local" is this device, "online" is e621 (see Services/Routes.cs). *@
@{
    var path = Context.Request.Path.Value ?? "";
    (string Text, string Url)[] items = Model switch
    {
        "posts" => [("Listing", "/posts"), ("Favorites", "/favorites"), ("Downloads", "/posts/downloads"), ("Blacklist", "/blacklist"), ("Bin", "/bin")],
        "artists" => [("Local", "/artists/local"), ("Online", "/artists/online")],
        "pools" => [("Local", "/pools/local"), ("Local gallery", "/pools/local/gallery"), ("Online", "/pools/online"), ("Online gallery", "/pools/online/gallery")],
        _ => [],
    };
    var suggested = Model == "pools" ? Watches.CountPoolSuggestions() : 0;
}
@foreach (var (text, url) in items)
{
  var id = "subnav-" + text.ToLowerInvariant().Replace(' ', '-');
  <li id="@id" class="@(path.Equals(url, StringComparison.OrdinalIgnoreCase) ? "current" : null)"><a href="@url" id="@id-link">@text@if (url == "/pools/local" && suggested > 0) { <span class="watch-badge">@suggested</span> }</a></li>
}
