@page "/artists/local"
@model SpankBank.Web.Pages.Artists.LocalModel
@using SpankBank.Core.Models
@{
    ViewData["Title"] = "Local artists";
    var view = Model.View;
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"artists"' />
}
@section Scripts {
  <script type="module" src="~/dist/watches.js" asp-append-version="true"></script>
}
<div id="c-artists" class="container-fluid">
  <div id="a-index">
    <partial name="_ListHeader" model='new SpankBank.Web.Services.ListHeaderModel("Local artists", Model.SearchActive, "Add artists")' />

    <div class="search-dropdown" id="searchform" hidden="@(!Model.SearchActive)">
      <form method="get" action="/artists/local" class="simple_form inline-form">
        <div class="input string"><label for="name">Name</label><input type="text" id="name" name="name" value="@Model.Name" autocomplete="off"><p class="hint">Use * for wildcard; aliases match too</p></div>
        <div class="input select">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="">Any</option>
            <option value="enabled" selected="@(Model.Status == "enabled")">Enabled</option>
            <option value="disabled" selected="@(Model.Status == "disabled")">Disabled</option>
          </select>
        </div>
        <input type="hidden" name="sort" value="@view.Sort"><input type="hidden" name="dir" value="@(view.Descending ? "desc" : "asc")">
        <input type="submit" value="Search" class="st-button">
      </form>
    </div>

    @if (Model.Message is not null) { <div class="notice notice-info">@Model.Message</div> }
    @if (Model.Error is not null) { <div class="notice notice-error">@Model.Error</div> }

    @if (Model.Bulk is { } bulk)
    {
      <div class="notice notice-info">
        Added @bulk.Added.Count, already watched @bulk.AlreadyWatched.Count, not recognized @bulk.Unrecognized.Count.
        @if (bulk.Added.Count > 0) { <div>Added: @string.Join(", ", bulk.Added)</div> }
        @if (bulk.AlreadyWatched.Count > 0) { <div>Already watched: @string.Join(", ", bulk.AlreadyWatched)</div> }
      </div>
      @if (bulk.Unrecognized.Count > 0)
      {
        <div class="notice notice-error">
          <p>Not recognized as artist tags (copy to fix and try again):</p>
          <textarea readonly rows="@Math.Min(12, bulk.Unrecognized.Count + 1)" style="width:100%" id="bulk-unrecognized">@string.Join("\n", bulk.Unrecognized.Select(u => u.Input))</textarea>
          @if (bulk.Unrecognized.Any(u => u.Suggestions.Count > 0))
          {
            <p>Did you mean:</p>
            <ul>
              @foreach (var u in bulk.Unrecognized.Where(u => u.Suggestions.Count > 0))
              {
                <li>@u.Input &rarr; @string.Join(", ", u.Suggestions)</li>
              }
            </ul>
          }
        </div>
      }
    }

    @if (Model.Artists.Total == 0)
    {
      <p>@(Model.SearchActive ? "No watched artists match." : "No artists watched.")</p>
    }
    else
    {
      <div class="table-scroll">
      <table class="striped watches-table artists-table" data-server-sorted>
        <thead>
          <tr class="group-headers">
            <th colspan="3" class="group-blank"></th>
            <th colspan="3" class="group-label sep">Characters</th>
            <th colspan="5" class="group-label sep">Posts</th>
            <th class="group-blank sep"></th>
          </tr>
          <tr class="column-headers">
            <th class="col-id" aria-sort="@view.AriaSort("id")"><a href="@view.SortUrl("id")">ID<span class="sort-mark">@(view.Mark("id"))</span></a></th>
            <th aria-sort="@view.AriaSort("name")"><a href="@view.SortUrl("name")">Artist<span class="sort-mark">@(view.Mark("name"))</span></a></th>
            <th class="col-num" aria-sort="@view.AriaSort("aliases")"><a href="@view.SortUrl("aliases")">Aliases<span class="sort-mark">@(view.Mark("aliases"))</span></a></th>
            <th class="col-count count-found sep" aria-sort="@view.AriaSort("found")"><a href="@view.SortUrl("found")" title="Characters found automatically"><svg-icon name="users" width="16" height="16" /><span class="sr-only">Found</span><span class="sort-mark">@(view.Mark("found"))</span></a></th>
            <th class="col-count count-enabled" aria-sort="@view.AriaSort("enabled")"><a href="@view.SortUrl("enabled")" title="Characters switched on"><svg-icon name="user_check" width="16" height="16" /><span class="sr-only">Enabled</span><span class="sort-mark">@(view.Mark("enabled"))</span></a></th>
            <th class="col-count count-custom" aria-sort="@view.AriaSort("custom")"><a href="@view.SortUrl("custom")" title="Characters you added yourself"><svg-icon name="user_plus" width="16" height="16" /><span class="sr-only">Custom</span><span class="sort-mark">@(view.Mark("custom"))</span></a></th>
            <th class="col-count count-db sep" aria-sort="@view.AriaSort("total")"><a href="@view.SortUrl("total")" title="Posts in the @SiteConfig.Name exports"><svg-icon name="database" width="16" height="16" /><span class="sr-only">In the exports</span><span class="sort-mark">@(view.Mark("total"))</span></a></th>
            <th class="col-count count-downloaded" aria-sort="@view.AriaSort("downloaded")"><a href="@view.SortUrl("downloaded")" title="Downloaded from @SiteConfig.Name"><svg-icon name="download" width="16" height="16" /><span class="sr-only">Downloaded</span><span class="sort-mark">@(view.Mark("downloaded"))</span></a></th>
            <th class="col-count count-restored" aria-sort="@view.AriaSort("restored")"><a href="@view.SortUrl("restored")" title="Restored from a source site or the Wayback Machine"><svg-icon name="history" width="16" height="16" /><span class="sr-only">Restored</span><span class="sort-mark">@(view.Mark("restored"))</span></a></th>
            <th class="col-count count-lost" aria-sort="@view.AriaSort("lost")"><a href="@view.SortUrl("lost")" title="Deleted on @SiteConfig.Name and not recoverable"><svg-icon name="skull" width="16" height="16" /><span class="sr-only">Lost</span><span class="sort-mark">@(view.Mark("lost"))</span></a></th>
            <th class="col-count count-pending" aria-sort="@view.AriaSort("pending")"><a href="@view.SortUrl("pending")" title="Still to be fetched: not tried yet or waiting for a retry"><svg-icon name="hourglass" width="16" height="16" /><span class="sr-only">Pending</span><span class="sort-mark">@(view.Mark("pending"))</span></a></th>
            <th class="col-status sep">Status</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model.Artists.Items)
          {
            var artist = item.Entry;
            <tr data-href="/artist/@Uri.EscapeDataString(artist.SourceValue)" tabindex="0">
              <td class="col-id" data-field="id">@artist.Id</td>
              <td data-field="name"><a href="/artist/@Uri.EscapeDataString(artist.SourceValue)" class="tag-type-1">@artist.DisplayName</a></td>
              <td class="col-num" data-field="aliases">@item.Aliases</td>
              <td class="col-count count-found sep">@item.Found.ToString("N0")</td>
              <td class="col-count count-enabled">@item.Enabled.ToString("N0")</td>
              <td class="col-count count-custom">@item.Custom.ToString("N0")</td>
              <td class="col-count count-db sep">@(artist.Matched ? artist.MatchCount.ToString("N0") : "-")</td>
              <td class="col-count count-downloaded">@item.Stats.Downloaded.ToString("N0")</td>
              <td class="col-count count-restored">@item.Stats.Restored.ToString("N0")</td>
              <td class="col-count count-lost">@item.Stats.Lost.ToString("N0")</td>
              <td class="col-count count-pending">@item.Stats.Pending.ToString("N0")</td>
              <td class="col-status sep watch-row-actions">
                <form method="post" asp-page-handler="Toggle" data-pill-toggle>
                  <input type="hidden" name="id" value="@artist.Id"><input type="hidden" name="enabled" value="@((!artist.Enabled).ToString().ToLowerInvariant())"><input type="hidden" name="returnUrl" value="@view.Current">
                  <button type="submit" class="status-pill @(artist.Enabled ? "is-enabled" : "is-disabled")" title="@(artist.Enabled ? "Click to disable" : "Click to enable")">@(artist.Enabled ? "Enabled" : "Disabled")</button>
                </form>
              </td>
            </tr>
          }
        </tbody>
      </table>
      </div>

      @if (Model.Artists.LastPage > 1)
      {
        <div class="list-footer">
          <partial name="_Paginator" model="new SpankBank.Web.Services.PagerModel(view.Page, Model.Artists.LastPage, view.PageUrl)" />
        </div>
      }
    }

    <div class="st-overlay hidden" id="modal-add" role="dialog" aria-modal="true" aria-labelledby="modal-add-title" tabindex="-1">
      <div class="st-overlay-wrapper">
        <button type="button" class="st-button close-button" aria-label="Close">&times;</button>
        <form method="post" asp-page-handler="Add" class="simple_form">
          <h1 id="modal-add-title">Add artists</h1>
          <div class="input">
            <label for="add-artists">Artist names</label>
            <textarea name="names" id="add-artists" rows="10" data-autocomplete="artist-list" autocomplete="off" spellcheck="false" required></textarea>
          </div>
          <p class="hint">One name per line (or comma separated); names suggest as you type. One artist opens their page, where you can adjust characters and filters before pressing Enable. Several are added enabled, and names that are not artists are listed afterwards.</p>
          <button type="submit" class="st-button submit">Add</button>
        </form>
      </div>
    </div>
  </div>
</div>
