@page "/artists/online"
@model SpankBank.Web.Pages.Artists.OnlineModel
@* Markup follows e621ng app/views/artists/index.html.erb (BSD-2, see THIRD-PARTY-NOTICES.md). *@
@{
    ViewData["Title"] = "Online artists";
    var view = Model.View;
}
@section Scripts {
  <script type="module" src="~/dist/watches.js" asp-append-version="true"></script>
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"artists"' />
}
<div id="c-artists" class="container-fluid">
  <div id="a-index">
    @* The search form is folded away until the Search button is pressed; it is open while a search is active. *@
    <div class="watches-header">
      <h1>Online artists</h1>
      <button type="button" class="st-button search-toggle" data-toggle="searchform" aria-controls="searchform" aria-expanded="@(Model.SearchActive ? "true" : "false")">Search</button>
    </div>

    <div class="search-dropdown" id="searchform" hidden="@(!Model.SearchActive)">
      <form method="get" action="/artists/online" class="simple_form inline-form">
        <div class="input string"><label for="name">Name</label><input type="text" id="name" name="name" value="@Model.Name" data-autocomplete="artist-tag" autocomplete="off"><p class="hint">Use * for wildcard</p></div>
        <div class="input boolean"><label for="empty">Show empty?</label><input type="checkbox" id="empty" name="empty" value="1" checked="@Model.ShowEmpty"></div>
        <input type="hidden" name="sort" value="@view.Sort"><input type="hidden" name="dir" value="@(view.Descending ? "desc" : "asc")">
        <input type="submit" value="Search" class="st-button">
      </form>
    </div>

    <div class="table-scroll">
    <table class="striped watches-table online-artists-table" data-server-sorted>
      <thead>
        <tr class="column-headers">
          <th class="col-id" aria-sort="@view.AriaSort("id")"><a href="@view.SortUrl("id")">ID<span class="sort-mark">@(view.Mark("id"))</span></a></th>
          <th aria-sort="@view.AriaSort("name")"><a href="@view.SortUrl("name")">Primary Name<span class="sort-mark">@(view.Mark("name"))</span></a></th>
          <th class="col-num" aria-sort="@view.AriaSort("posts")"><a href="@view.SortUrl("posts")">Posts<span class="sort-mark">@(view.Mark("posts"))</span></a></th>
          <th>Aliases</th>
          <th class="col-status sep">Watched</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var artist in Model.Result.Rows)
        {
          var watched = Model.Watched.Contains(artist.Name);
          <tr>
            <td class="col-id">@artist.Id</td>
            <td class="category-1"><a href="/artist/@Uri.EscapeDataString(artist.Name)">@artist.Name</a></td>
            <td class="col-num">@artist.PostCount.ToString("N0")</td>
            <td>@string.Join(", ", artist.OtherNames)</td>
            <td class="col-status sep"><span class="status-pill @(watched ? "is-enabled" : "is-disabled")">@(watched ? "Yes" : "No")</span></td>
          </tr>
        }
        @if (Model.Result.Rows.Count == 0)
        {
          <tr><td colspan="5">No artists match.</td></tr>
        }
      </tbody>
    </table>
    </div>

    @if (Model.LastPage > 1)
    {
      <div class="list-footer">
        <partial name="_Paginator" model="new SpankBank.Web.Services.PagerModel(Model.PageNumber, Model.LastPage, Model.PageUrl)" />
      </div>
    }
  </div>
</div>
