@page "/artist/{name}"
@model SpankBank.Web.Pages.Artists.ShowModel
@{
    var artist = Model.Artist;
    ViewData["Title"] = artist.Name;
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"artists"' />
}
<div id="c-artists" class="container-fluid">
  <div id="a-show">
    @if (Model.Message is not null) { <div class="notice notice-info">@Model.Message</div> }

    <h1 class="category-1"><a href="/posts?tags=@Uri.EscapeDataString(artist.Name)">@artist.Name.Replace('_', ' ')</a></h1>

    <table class="striped" style="max-width: 50rem;">
      <tbody>
        <tr><th>Other names</th><td>@(artist.OtherNames.Count == 0 ? "-" : string.Join(", ", artist.OtherNames))</td></tr>
        <tr><th>Posts online</th><td>@artist.PostCount.ToString("N0") (<a href="https://e621.net/posts?tags=@Uri.EscapeDataString(artist.Name)" rel="nofollow noopener">view</a>, <a href="https://e621.net/artists/show_or_new?name=@Uri.EscapeDataString(artist.Name)" rel="nofollow noopener">artist page</a>)</td></tr>
        <tr><th>Posts local</th><td>@Model.DownloadedCount.ToString("N0") @if (Model.DownloadedCount > 0) { <text>(<a href="/posts?tags=@Uri.EscapeDataString(artist.Name)">view</a>)</text> }</td></tr>
        <tr>
          <th>Watching</th>
          <td>
            @if (Model.Watch is { } watch)
            {
              <text>Yes, @(watch.Enabled ? "enabled" : "disabled"): @(watch.Matched ? $"{watch.MatchText} posts matched" : "waiting to be matched"). <a href="/artists/local">Manage</a></text>
            }
            else
            {
              <form method="post" asp-page-handler="Watch" style="display:inline">
                <input type="hidden" name="name" value="@artist.Name">
                <button type="submit" class="st-button">Watch this artist</button>
              </form>
            }
          </td>
        </tr>
      </tbody>
    </table>

    @if (Model.Characters.Count > 0)
    {
      <h2 style="margin-top: 1.5rem;">Characters</h2>
      <p>Character tags ending in <code>_(@artist.Name)</code> or one of the other names. Watching the artist includes them.</p>
      <ul>
        @foreach (var character in Model.Characters)
        {
          <li class="category-4"><a href="/posts?tags=@Uri.EscapeDataString(character)">@character</a></li>
        }
      </ul>
    }

    @if (Model.Watch is not null)
    {
      <section id="pools" class="artist-pools">
        <h2 style="margin-top: 1.5rem;">Pools</h2>

        @if (Model.WatchedPools.Count > 0)
        {
          <p>Local pools added for this artist:</p>
          <ul>
            @foreach (var pool in Model.WatchedPools)
            {
              <li><a href="/pool/@pool.SourceValue">@pool.DisplayName</a> <span class="watch-origin">(@(pool.Pool is { } info ? $"{info.PostCount} posts" : "not in the export yet")@(pool.Enabled ? "" : ", disabled"))</span></li>
            }
          </ul>
        }

        <p class="hint">Pools that mostly hold this artist's work are added automatically (see Settings). These are the other pools that contain their posts:</p>
        @if (Model.Suggestions.Count == 0)
        {
          <p>Nothing to review.</p>
        }
        else
        {
          <table class="striped" style="max-width: 60rem;">
            <thead><tr><th>Pool</th><th>Type</th><th>Their share</th><th></th></tr></thead>
            <tbody>
              @foreach (var suggestion in Model.Suggestions)
              {
                <tr>
                  <td><a href="/pool/@suggestion.PoolId">@suggestion.PoolName</a></td>
                  <td>@suggestion.Category</td>
                  <td>@suggestion.ArtistPosts of @suggestion.PoolPosts (@suggestion.SharePercent.ToString("0")%)@(suggestion.IsRoot ? "" : " · part of a larger pool")</td>
                  <td class="watch-row-actions" style="white-space: nowrap; text-align: right;">
                    <form method="post" asp-page-handler="AcceptSuggestion" style="display:inline-block">
                      <input type="hidden" name="poolId" value="@suggestion.PoolId"><input type="hidden" name="name" value="@artist.Name">
                      <a href="#" data-submit>Add</a>
                    </form>
                    <form method="post" asp-page-handler="IgnoreSuggestion" style="display:inline-block; margin-left: 0.75rem">
                      <input type="hidden" name="artistId" value="@suggestion.ArtistWatchId"><input type="hidden" name="poolId" value="@suggestion.PoolId"><input type="hidden" name="name" value="@artist.Name">
                      <a href="#" data-submit>Ignore</a>
                    </form>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        }
        <p><a href="/artist/@Uri.EscapeDataString(artist.Name)@(Model.ShowAllSuggestions ? "" : "?all=1")#pools">@(Model.ShowAllSuggestions ? "Show only likely pools" : "Show every pool with at least two of their posts")</a></p>
      </section>
    }

    @if (Model.RecentPosts.Count > 0)
    {
      <div class="recent-posts">
        <h1>Local posts (<a href="/posts?tags=@Uri.EscapeDataString(artist.Name)">view all</a>)</h1>
        <section class="posts-container">
          @foreach (var post in Model.RecentPosts)
          {
            <partial name="_PostThumbnail" model="post" />
          }
        </section>
      </div>
    }
  </div>
</div>
<script type="module" src="~/dist/watches.js" asp-append-version="true"></script>
