@page "/artist/{name}"
@model SpankBank.Web.Pages.Artists.ShowModel
@using SpankBank.Core.Models
@{
    var artist = Model.Artist;
    ViewData["Title"] = artist.Name;
}
@section SecondaryNav {
  <partial name="_AreaNav" model='"artists"' />
}
<div id="c-artists" class="container-fluid">
  <div id="a-show">
    @if (Model.Message is not null) { <div class="notice notice-info">@Model.Message</div> }

    <h1 class="category-1"><a href="/posts?tags=@Uri.EscapeDataString(artist.Name)">@artist.Name.Replace('_', ' ')</a></h1>

    <div class="artist-layout@(Model.Watch is not null ? " has-side" : "")">
    <div class="artist-main">
    <table class="striped artist-info-table">
      <tbody>
        <tr><th>Other names:</th><td>@(artist.OtherNames.Count == 0 ? "-" : string.Join(", ", artist.OtherNames))</td></tr>
        <tr><th>Posts online:</th><td>@artist.PostCount.ToString("N0") (<a href="https://e621.net/posts?tags=@Uri.EscapeDataString(artist.Name)" rel="nofollow noopener">view</a>, <a href="https://e621.net/artists/show_or_new?name=@Uri.EscapeDataString(artist.Name)" rel="nofollow noopener">artist page</a>)</td></tr>
        <tr><th>Posts local:</th><td>@Model.DownloadedCount.ToString("N0") @if (Model.DownloadedCount > 0) { <text>(<a href="/posts?tags=@Uri.EscapeDataString(artist.Name)">view</a>)</text> }</td></tr>
        @if (Model.Watch is { } statsWatch)
        {
          <tr>
            <th>Post stats:</th>
            <td>
              <span class="post-stats">
                <span class="count-db" title="Posts in the e621 exports"><svg-icon name="database" width="16" height="16" /> @(statsWatch.Matched ? statsWatch.MatchCount.ToString("N0") : "-") <span class="stat-label">in the exports</span></span>
                <span class="count-downloaded" title="Downloaded from e621"><svg-icon name="download" width="16" height="16" /> @Model.Stats.Downloaded.ToString("N0") <span class="stat-label">downloaded</span></span>
                <span class="count-restored" title="Restored from the Wayback Machine"><svg-icon name="history" width="16" height="16" /> @Model.Stats.Restored.ToString("N0") <span class="stat-label">restored</span></span>
                <span class="count-lost" title="Deleted on e621 and not recoverable"><svg-icon name="skull" width="16" height="16" /> @Model.Stats.Lost.ToString("N0") <span class="stat-label">lost</span></span>
              </span>
            </td>
          </tr>
        }
        <tr>
          <th>Watching:</th>
          <td>
            @if (Model.Watch is { } watch)
            {
              <text>@(watch.Enabled ? "Enabled" : "Not enabled"): @(watch.Matched ? $"{watch.MatchText} posts matched" : "waiting to be matched"). <a href="#watch">Settings</a></text>
            }
            else
            {
              <form method="post" asp-page-handler="Watch" asp-route-name="@artist.Name" style="display:inline">
                <input type="hidden" name="name" value="@artist.Name">
                <button type="submit" class="st-button">Watch this artist</button>
              </form>
            }
          </td>
        </tr>
      </tbody>
    </table>

    @if (Model.Watch is { } w)
    {
      var aliases = w.ArtistTags.Where(t => t.Kind == ArtistTagKind.Alias).ToList();
      <section id="watch" class="artist-watch">
        <div class="artist-watch-head">
          <h2>Watch settings</h2>
          <span class="watch-state @(w.Enabled ? "is-enabled" : "is-disabled")">@(w.Enabled ? "Enabled" : "Not enabled")</span>
        </div>

        @if (Model.Error is not null) { <div class="notice notice-error">@Model.Error</div> }
        @if (!w.Enabled)
        {
          <div class="notice notice-info">This artist is not enabled: nothing is matched or downloaded. Adjust the characters and filters, then press <strong>Enable</strong>.</div>
        }

        <div class="watch-actions">
          <form method="post" asp-page-handler="Toggle" asp-route-name="@artist.Name">
            <input type="hidden" name="id" value="@w.Id"><input type="hidden" name="enabled" value="@((!w.Enabled).ToString().ToLowerInvariant())">
            <button type="submit" class="st-button@(w.Enabled ? "" : " primary")">@(w.Enabled ? "Disable" : "Enable")</button>
          </form>
          <form method="post" asp-page-handler="Rescan" asp-route-name="@artist.Name">
            <input type="hidden" name="id" value="@w.Id">
            <button type="submit" class="st-button" title="Look for new aliases and characters in the catalog">Rescan</button>
          </form>
          <form method="post" asp-page-handler="IgnoreBlacklist" asp-route-name="@artist.Name" title="Download this artist's posts even when the global blacklist matches them">
            <input type="hidden" name="id" value="@w.Id"><input type="hidden" name="ignore" value="@((!w.IgnoreBlacklist).ToString().ToLowerInvariant())">
            <button type="submit" class="st-button">@(w.IgnoreBlacklist ? "Use global blacklist" : "Ignore global blacklist")</button>
          </form>
          <form method="post" asp-page-handler="Delete" asp-route-name="@artist.Name" data-removal="@artist.Name">
            <input type="hidden" name="id" value="@w.Id"><input type="hidden" name="posts" value="">
            <button type="submit" class="st-button">Remove artist</button>
          </form>
        </div>

        @if (aliases.Count > 0)
        {
          <p class="watch-aliases"><strong>Also known as:</strong> @string.Join(", ", aliases.Select(a => a.Tag))</p>
        }

        <form method="post" asp-page-handler="SaveFilters" asp-route-name="@artist.Name" class="artist-filters-form">
          <input type="hidden" name="id" value="@w.Id">
          <h3>Filters</h3>
          <p class="hint">One tag expression per line, written like a post search: <code>rating:s canine</code> is a single expression that needs both. Applied to this artist's posts only.</p>
          <div class="artist-filters">
            <div class="input">
              <label for="whitelist">Whitelist</label>
              <textarea id="whitelist" name="whitelist" rows="8" spellcheck="false" autocomplete="off" placeholder="rating:s&#10;canine -comic">@w.Whitelist</textarea>
              <p class="hint">A post must match at least one line to be downloaded and kept. Empty means every post of the artist.</p>
            </div>
            <div class="input">
              <label for="blacklist">Blacklist</label>
              <textarea id="blacklist" name="blacklist" rows="8" spellcheck="false" autocomplete="off" placeholder="gore&#10;rating:e feline">@w.Blacklist</textarea>
              <p class="hint">A post matching any line is not downloaded, and one already downloaded becomes a <a href="/posts?tags=stray%3Atrue">stray</a>.</p>
            </div>
          </div>
          <button type="submit" class="st-button">Save filters</button>
        </form>
      </section>
    }
    </div>

    @if (Model.Watch is { } cw)
    {
      var characters = cw.ArtistTags.Where(t => t.Kind == ArtistTagKind.Character).ToList();
      var enabledCharacters = characters.Count(c => c.Enabled);
      <aside class="artist-side">
        <details class="artist-characters" open data-artist-characters>
          <summary>Characters <span class="count" data-char-count>@enabledCharacters / @characters.Count enabled</span></summary>
          <p class="hint">Character tags ending in <code>_(@artist.Name)</code> or one of the other names. A character that is switched off is not part of this artist's posts.</p>

          <form method="post" asp-page-handler="ToggleTag" asp-route-name="@artist.Name" id="chip-form" hidden>
            <input type="hidden" name="tagId" value=""><input type="hidden" name="enabled" value="">
          </form>

          <form method="post" asp-page-handler="AddTag" asp-route-name="@artist.Name" class="character-add watch-add-tag">
            <input type="hidden" name="id" value="@cw.Id">
            <input type="text" name="tag" data-autocomplete="character-tag" data-validate-tag="4" autocomplete="off" placeholder="Add a character">
            <button type="submit" class="st-button" disabled>Add</button>
          </form>

          @if (characters.Count > 0)
          {
            <div class="character-tools">
              <input type="search" placeholder="Filter characters" data-char-filter autocomplete="off">
              <form method="post" asp-page-handler="SetAllTags" asp-route-name="@artist.Name">
                <input type="hidden" name="id" value="@cw.Id"><input type="hidden" name="enabled" value="true">
                <button type="submit" class="st-button">Enable all</button>
              </form>
              <form method="post" asp-page-handler="SetAllTags" asp-route-name="@artist.Name">
                <input type="hidden" name="id" value="@cw.Id"><input type="hidden" name="enabled" value="false">
                <button type="submit" class="st-button">Disable all</button>
              </form>
            </div>
            <div class="character-table-wrap">
              <table class="striped watches-table character-table">
                <thead><tr><th class="col-id">ID</th><th>Character</th><th class="col-num">Posts</th><th class="col-auto"></th></tr></thead>
                <tbody>
                  @foreach (var tag in characters)
                  {
                    var known = Model.CharacterTags.TryGetValue(tag.Tag, out var info);
                    <tr class="character-row@(tag.Enabled ? " is-on" : "")" data-name="@tag.Tag">
                      <td class="col-id">@(known ? info!.Id.ToString() : "-")</td>
                      <td><a href="/posts?tags=@Uri.EscapeDataString(tag.Tag)" class="tag-type-4">@tag.Tag.Replace('_', ' ')</a>@if (tag.IsManual) { <span class="watch-manual"> (added by you)</span> }</td>
                      <td class="col-num">@(known ? info!.PostCount.ToString("N0") : "-")</td>
                      <td class="col-auto character-actions">
                        <a href="#" class="char-toggle" data-tag-id="@tag.Id">@(tag.Enabled ? "Disable" : "Enable")</a>
                        @if (tag.IsManual)
                        {
                          <a href="#" class="char-remove" data-tag-id="@tag.Id" title="Remove this character you added">Remove</a>
                        }
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          }
          else
          {
            <p>No characters found for this artist.</p>
          }
        </details>
      </aside>
    }
    </div>

    @if (Model.Watch is null && Model.Characters.Count > 0)
    {
      <h2 style="margin-top: 1.5rem;">Characters</h2>
      <p>Character tags ending in <code>_(@artist.Name)</code> or one of the other names. Watching the artist includes them.</p>
      <ul class="character-chips">
        @foreach (var character in Model.Characters)
        {
          <li class="character-chip is-on"><a href="/posts?tags=@Uri.EscapeDataString(character)" class="chip-toggle">@character.Replace('_', ' ')</a></li>
        }
      </ul>
    }

    @if (Model.Watch is not null)
    {
      var toggleAction = $"/artist/{Uri.EscapeDataString(artist.Name)}?handler=TogglePool";
      <section id="pools" class="artist-pools">
        <h2 style="margin-top: 1.5rem;">Pools</h2>

        @if (Model.WatchedPools.Count > 0)
        {
          <partial name="_PoolsTable" model="new SpankBank.Web.Services.PoolsTableModel(Model.WatchedPools, toggleAction, null, ShowArtist: false, Editable: false)" />
        }

        <p class="hint">Pools that mostly hold this artist's work are added automatically (see Settings). These are the other pools that contain their posts:</p>
        @if (Model.Suggestions.Count == 0)
        {
          <p>Nothing to review.</p>
        }
        else
        {
          <table class="striped">
            <thead><tr><th>Pool</th><th>Type</th><th>Their share</th><th></th></tr></thead>
            <tbody>
              @foreach (var suggestion in Model.Suggestions)
              {
                <tr>
                  <td><a href="/pool/@suggestion.PoolId">@suggestion.PoolName</a></td>
                  <td>@suggestion.Category</td>
                  <td>@suggestion.ArtistPosts of @suggestion.PoolPosts (@suggestion.SharePercent.ToString("0")%)@(suggestion.IsRoot ? "" : " · part of a larger pool")</td>
                  <td class="watch-row-actions" style="white-space: nowrap; text-align: right;">
                    <form method="post" asp-page-handler="AcceptSuggestion" style="display:inline-block">
                      <input type="hidden" name="poolId" value="@suggestion.PoolId"><input type="hidden" name="name" value="@artist.Name">
                      <a href="#" data-submit>Add</a>
                    </form>
                    <form method="post" asp-page-handler="IgnoreSuggestion" style="display:inline-block; margin-left: 0.75rem">
                      <input type="hidden" name="artistId" value="@suggestion.ArtistWatchId"><input type="hidden" name="poolId" value="@suggestion.PoolId"><input type="hidden" name="name" value="@artist.Name">
                      <a href="#" data-submit>Ignore</a>
                    </form>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        }
        <p><a href="/artist/@Uri.EscapeDataString(artist.Name)@(Model.ShowAllSuggestions ? "" : "?all=1")#pools">@(Model.ShowAllSuggestions ? "Show only likely pools" : "Show every pool with at least two of their posts")</a></p>
      </section>
    }

    @if (Model.RecentPosts.Count > 0)
    {
      <div class="recent-posts">
        <h1>Local posts (<a href="/posts?tags=@Uri.EscapeDataString(artist.Name)">view all</a>)</h1>
        <section class="posts-container">
          @foreach (var post in Model.RecentPosts)
          {
            <partial name="_PostThumbnail" model="post" />
          }
        </section>
      </div>
    }
  </div>
</div>
<script type="module" src="~/dist/watches.js" asp-append-version="true"></script>
