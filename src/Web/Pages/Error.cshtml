@page "/error"
@model SpankBank.Web.Pages.ErrorModel
@* Shown inside the normal layout for any browser request that ends in an error status without a page of its own (Program.cs). *@
@{
    ViewData["Title"] = Model.Title;
    ViewData["BodyClass"] = "c-status";
}
<div id="c-error" class="container">
  <h1>@Model.Title</h1>
  @if (Model.Code == 404)
  {
    <p>There is nothing at <code>@Model.RequestedPath</code>. It may have moved or never existed; use the menu above, or <a href="/posts">go to the posts</a>.</p>
  }
  else
  {
    <p>The server answered @Model.Code for <code>@Model.RequestedPath</code>. Use the menu above, or <a href="/posts">go to the posts</a>.</p>
  }
</div>
