@page "/status"
@model SpankBank.Web.Pages.StatusModel
@{
    ViewData["Title"] = "Status";
}
<div id="c-status" class="container"><div id="a-index">
  <h1>Status</h1>

  @if (Model.Message is not null)
  {
    <div class="notice notice-info" style="margin-bottom: 1em;">@Model.Message</div>
  }

  <section id="activity" class="status-activity" aria-live="polite">
    <div class="status-offline" hidden>The worker is not reachable.</div>
    <div class="status-run" hidden></div>
    <div class="status-downloads" hidden></div>
  </section>

  <form method="post" class="status-actions">
    <button type="submit" class="st-button">Update from e621 now</button>
  </form>

  <table class="striped">
    <tbody>
      <tr><th>Last run started</th><td>@(Model.LastRunStartedAt ?? "never")</td></tr>
      <tr><th>Last run completed</th><td>@(Model.LastRunCompletedAt ?? "never")</td></tr>
      <tr><th>Last result</th><td>@(Model.LastRunResult ?? "-")</td></tr>
      <tr><th>Daily run (UTC)</th><td>@Model.DailyRunTimeUtc</td></tr>
      <tr><th>Posts in catalog</th><td>@Model.PostCount.ToString("N0")</td></tr>
      <tr><th>Local files</th><td>@Model.DownloadedCount.ToString("N0")</td></tr>
      <tr><th>Waiting to download</th><td>@Model.Waiting.ToString("N0")@(Model.DownloadsPaused ? " (downloads are paused)" : "")</td></tr>
      <tr><th>Saved today</th><td>@Model.SavedToday.ToString("N0") of @Model.DailyLimit.ToString("N0")</td></tr>
    </tbody>
  </table>

  <h2 style="margin-top: 1.5em;">Recent imports</h2>
  <table class="striped">
    <thead><tr><th>Type</th><th>File</th><th>Started</th><th>Rows</th><th>Result</th></tr></thead>
    <tbody>
      @foreach (var entry in Model.Imports)
      {
        <tr>
          <td>@entry.ImportType</td>
          <td>@System.IO.Path.GetFileName(entry.SourcePath)</td>
          <td>@entry.StartedAt.ToString("u")</td>
          <td>@entry.RowsProcessed.ToString("N0")</td>
          <td>@(entry.Succeeded ? "ok" : entry.ErrorMessage)</td>
        </tr>
      }
      @if (Model.Imports.Count == 0)
      {
        <tr><td colspan="5">No imports yet.</td></tr>
      }
    </tbody>
  </table>
</div></div>
<script type="module" src="~/dist/status.js" asp-append-version="true"></script>
